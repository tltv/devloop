#!/usr/bin/env bash
# vaadin-dev - thin client over the dev-loop daemon's local RPC.
#
# Nobody starts the daemon by hand: the first command auto-spawns it and every
# later command from any shell, agent or IDE reuses that same instance, so there
# is exactly one authoritative answer to "what is the state of my last change?"
#
# Exit code is the outcome: 0 success, non-zero failure. Progress goes to stdout.
# Deliberately no JVM start per command - the handshake file is a properties file
# and the transport is bash's /dev/tcp, so `vaadin-dev status` costs milliseconds.
set -uo pipefail

# ROOT is the application: everything the daemon touches - sources, target/,
# .vaadin/, the Maven wrapper - lives here, because the daemon serves one app and
# uses only that app's build.
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
HANDSHAKE="$ROOT/.vaadin/daemon.properties"
DAEMON_LOG="$ROOT/target/devloop/daemon.log"

# Where the daemon's own jars come from. In a shipped version these would be
# provisioned into .vaadin/ the way HotswapAgent already is; in this prototype they
# are built from the sibling module when that is present.
DAEMON_HOME="${VAADIN_DEV_HOME:-$ROOT/.vaadin}"
DAEMON_JAR="$DAEMON_HOME/devloop-daemon.jar"
AGENT_JAR="$DAEMON_HOME/devloop-daemon-agent.jar"
DAEMON_MODULE="$ROOT/../devloop-daemon"

usage() {
    cat <<'EOF'
usage: vaadin-dev <command> [options]

  status [--json]   app up? owner? dev server? current/last transaction
  apply [--json]    commit pending edits; blocks until Stable or Failed
                    (--no-restart to stop after the compile gate)
  start             launch the app in dev mode (daemon owns it)
  stop              stop the app
  restart           stop then start
  shutdown          stop the daemon (and the app it owns)
  ping              check the daemon is alive

  redefine <a.b.C,...>
                    diagnostic: push named classes at the running app and print
                    the raw reply, without apply's escalation policy

The daemon starts automatically on first use and serves this application only.

  VAADIN_DEV_HOME          where the daemon's jars live (default: ./.vaadin)
  VAADIN_DEV_DAEMON_OPTS   JVM options for the daemon, e.g.
                           -Dvaadin.frontend.hotdeploy=true (any vaadin.* property
                           is forwarded on to the app) or -Dvaadin.dev.idleSeconds=60
EOF
}

read_prop() { # $1=key
    [[ -f "$HANDSHAKE" ]] || return 1
    local value
    value="$(grep -E "^$1=" "$HANDSHAKE" 2>/dev/null | head -1 | cut -d= -f2-)"
    [[ -n "$value" ]] || return 1
    printf '%s' "$value"
}

java_bin() {
    if [[ -n "${JAVA_HOME:-}" && -x "$JAVA_HOME/bin/java" ]]; then
        printf '%s' "$JAVA_HOME/bin/java"
    else
        printf '%s' java
    fi
}

# The java agent is one dependency-free class whose whole job is to publish the
# JVM's Instrumentation handle, so the CLI carries its source and builds it on
# demand rather than shipping a second artifact that has to be kept in step.
# This is the only copy of that source.
build_agent_if_needed() {
    [[ -f "$AGENT_JAR" ]] && return 0

    local jdk_bin javac_bin jar_bin
    jdk_bin="$(dirname "$(java_bin)")"
    javac_bin="$jdk_bin/javac"; [[ -x "$javac_bin" ]] || javac_bin=javac
    jar_bin="$jdk_bin/jar";     [[ -x "$jar_bin"   ]] || jar_bin=jar
    if ! command -v "$javac_bin" >/dev/null || ! command -v "$jar_bin" >/dev/null; then
        echo "vaadin-dev: a JDK is required (javac and jar) to build the agent" >&2
        exit 70
    fi

    local work
    work="$(mktemp -d)" || { echo "vaadin-dev: cannot create a temp dir" >&2; exit 70; }
    mkdir -p "$work/src/com/vaadin/devloop/agent"

    cat > "$work/src/com/vaadin/devloop/agent/DevLoopAgent.java" <<'JAVA'
package com.vaadin.devloop.agent;

import java.lang.instrument.Instrumentation;

/**
 * Captures the Instrumentation handle at JVM startup and publishes it, so that the
 * in-app connector can perform atomic class redefinitions in-process.
 *
 * Published two ways, so the connector finds it regardless of which class loader
 * ends up owning the application classes: as a static field here (works when the
 * agent jar is visible to the app loader, the normal case since agent jars are
 * appended to the system class path), and as a value in the system properties
 * table, which is a Hashtable<Object, Object> and can therefore carry an arbitrary
 * object - that path needs no class visibility at all.
 *
 * Zero dependencies beyond java.instrument. The source of truth for this class is
 * the vaadin-dev script, which compiles it on demand.
 */
public final class DevLoopAgent {

    public static final String PROPERTY = "devloop.instrumentation";

    private static volatile Instrumentation instrumentation;

    private DevLoopAgent() {
    }

    public static void premain(String args, Instrumentation inst) {
        install(inst);
    }

    public static void agentmain(String args, Instrumentation inst) {
        install(inst);
    }

    private static void install(Instrumentation inst) {
        instrumentation = inst;
        System.getProperties().put(PROPERTY, inst);
        System.out.println("[devloop-agent] Instrumentation captured; "
                + "redefineClasses supported=" + inst.isRedefineClassesSupported());
    }

    public static Instrumentation get() {
        return instrumentation;
    }
}
JAVA

    # A manifest's entry list has to end with a newline; the heredoc provides it.
    cat > "$work/manifest.mf" <<'MF'
Premain-Class: com.vaadin.devloop.agent.DevLoopAgent
Agent-Class: com.vaadin.devloop.agent.DevLoopAgent
Can-Redefine-Classes: true
Can-Retransform-Classes: true
MF

    echo "building the dev-loop agent..." >&2
    # --release 21 so the agent loads in any JVM a Vaadin 25 app can run on, not
    # only the one that happened to build it.
    if ! "$javac_bin" --release 21 -d "$work/classes" \
            "$work/src/com/vaadin/devloop/agent/DevLoopAgent.java" >&2; then
        rm -rf "$work"; echo "vaadin-dev: could not compile the agent" >&2; exit 70
    fi

    # Packaged aside and moved into place, so a half-written jar is never loaded.
    if ! "$jar_bin" --create --file "$work/agent.jar" \
            --manifest "$work/manifest.mf" -C "$work/classes" . >&2; then
        rm -rf "$work"; echo "vaadin-dev: could not package the agent" >&2; exit 70
    fi
    mkdir -p "$DAEMON_HOME"
    mv "$work/agent.jar" "$AGENT_JAR"
    rm -rf "$work"
}

build_daemon_if_needed() {
    build_agent_if_needed

    [[ -f "$DAEMON_JAR" ]] && return 0

    if [[ ! -d "$DAEMON_MODULE" ]]; then
        echo "vaadin-dev: no devloop-daemon.jar in $DAEMON_HOME and no" \
             "devloop-daemon module to build one from. Set VAADIN_DEV_HOME to a" \
             "directory containing devloop-daemon.jar." >&2
        exit 70
    fi

    echo "building devloop-daemon..." >&2
    # Only the daemon module: it has no dependencies, so this stays quick and never
    # drags the app's frontend build in. Run from here so the wrapper finds .mvn,
    # and point it at the aggregator that owns the module.
    ( cd "$ROOT" && ./mvnw -q -o -f ../pom.xml -pl devloop-daemon package -DskipTests ) >&2 \
        || { echo "vaadin-dev: could not build devloop-daemon" >&2; exit 70; }

    mkdir -p "$DAEMON_HOME"
    cp "$DAEMON_MODULE/target/devloop-daemon.jar" "$DAEMON_JAR"
}

spawn_daemon() {
    build_daemon_if_needed
    mkdir -p "$(dirname "$DAEMON_LOG")"
    # Detached: the daemon outlives this shell so later commands reuse it.
    # The agent path is passed in because the CLI knows the module layout.
    nohup "$(java_bin)" ${VAADIN_DEV_DAEMON_OPTS:-} \
        "-Dvaadin.dev.agentJar=$AGENT_JAR" \
        -jar "$DAEMON_JAR" "$ROOT" \
        >>"$DAEMON_LOG" 2>&1 &
    disown 2>/dev/null || true

    # Wait for the handshake file rather than sleeping a fixed amount.
    local waited=0
    while (( waited < 200 )); do
        if [[ -f "$HANDSHAKE" ]] && read_prop port >/dev/null; then
            return 0
        fi
        sleep 0.1
        (( waited++ ))
    done
    echo "vaadin-dev: daemon did not come up; see $DAEMON_LOG" >&2
    return 70
}

# Sends one command and streams the reply. Response lines are "> text" progress
# followed by a final "EXIT <code>" which becomes this script's exit status.
send() { # $1=port $2=token $3...=command words
    local port="$1" token="$2"; shift 2
    # The braces matter: bash reports a failed /dev/tcp redirection itself, so the
    # suppression has to wrap the redirection, not the command.
    if ! { exec 3<>"/dev/tcp/127.0.0.1/$port"; } 2>/dev/null; then
        return 99
    fi
    printf '%s %s\n' "$token" "$*" >&3
    local line status=1
    while IFS= read -r line <&3; do
        line="${line%$'\r'}"
        case "$line" in
            "EXIT "*) status="${line#EXIT }"; break ;;
            "> "*)    printf '%s\n' "${line#> }" ;;
            *)        printf '%s\n' "$line" ;;
        esac
    done
    exec 3<&- 2>/dev/null || true
    return "$status"
}

main() {
    local cmd="${1:-}"
    case "$cmd" in
        ""|-h|--help|help) usage; exit 0 ;;
    esac
    shift

    local port token
    if ! port="$(read_prop port)" || ! token="$(read_prop token)"; then
        spawn_daemon || exit 70
        port="$(read_prop port)"; token="$(read_prop token)"
    fi

    send "$port" "$token" "$cmd" "$@"
    local status=$?

    # 99 means the recorded daemon is not answering: the record is stale, so reap
    # it and try once more with a fresh daemon.
    if (( status == 99 )); then
        rm -f "$HANDSHAKE"
        spawn_daemon || exit 70
        port="$(read_prop port)"; token="$(read_prop token)"
        send "$port" "$token" "$cmd" "$@"
        status=$?
        (( status == 99 )) && { echo "vaadin-dev: cannot reach daemon" >&2; exit 70; }
    fi
    exit "$status"
}

main "$@"
